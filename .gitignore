# Development diary stays local - not part of the repository.
Diary/

# Python bytecode
__pycache__/
*.py[cod]

# Test runner cache
.pytest_cache/

# Runtime state of the bot's mind - never committed.
# Design clause IO-5: what the AI holds is one stream of consciousness,
# not files; pictures are not memories. data/ holds the whole mind: the
# short term buffer, the sleep ledger and every long term store.
data/

# Uplink deployment file - it carries the shared bearer token (OPEN-7).
# configs/uplink.example.json is the committed template.
configs/uplink.json
